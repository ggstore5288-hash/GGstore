{
  "name": "gaming-ecommerce-backend",
  "version": "1.0.0",
  "description": "Production-ready backend for digital gaming and subscription e-commerce platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/scripts/seed.js",
    "create-admin": "node src/scripts/createAdmin.js",
    "format": "prettier --write \"src/**/*.{js,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,json}\""
  },
  "lint-staged": {
    "*.{js,json}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "ecommerce",
    "gaming",
    "subscription",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.23.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.4",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  }
}
